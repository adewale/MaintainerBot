{
  "name": "maintainer-bot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "vite build --mode node",
    "build:cloudflare": "vite build --mode cloudflare",
    "dev": "vite dev --mode node",
    "dev:cloudflare": "vite dev --mode cloudflare",
    "preview": "vite preview --mode node",
    "deploy:cloudflare": "vite build --mode cloudflare && wrangler deploy",
    "deploy:status": "wrangler deploy --config wrangler.status.jsonc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "daily": "tsx scripts/run-daily.ts",
    "deep:verify": "tsx scripts/run-deep-verify.ts",
    "save:daily": "tsx scripts/run-daily.ts",
    "reject": "node scripts/reject.mjs",
    "test:mediabunny:gist": "node scripts/test-mediabunny-video-convert-local.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@flue/runtime": "2.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "agents": "^0.20.1",
    "hono": "^4.13.13",
    "just-bash": "^3.0.1",
    "valibot": "^1.4.2"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.31.0",
      "@modelcontextprotocol/client": "2.3.1",
      "@hono/node-server": "2.1.4",
      "hono": "4.13.13",
      "valibot": "1.4.2",
      "express>proxy-addr": "2.0.8",
      "express>body-parser": "2.3.0",
      "qs": "6.16.0",
      "ajv>fast-uri": "3.1.8",
      "express-rate-limit>ip-address": "10.7.1",
      "protobufjs": "7.6.5",
      "minimatch>brace-expansion": "5.0.12",
      "smol-toml": "1.9.1",
      "js-yaml": "5.4.1"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@flue/cli": "2.0.0",
    "@flue/vite": "2.0.0",
    "@types/node": "^22.20.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
