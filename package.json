{
  "name": "maintainer-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "flue build --target node",
    "build:cloudflare": "flue build --target cloudflare",
    "dev": "flue dev --target node",
    "dev:cloudflare": "flue dev --target cloudflare",
    "deploy:cloudflare": "flue build --target cloudflare && wrangler deploy --config dist/maintainerbot/wrangler.json",
    "deploy:status": "wrangler deploy --config wrangler.status.jsonc",
    "daily": "flue run daily-maintenance --target node --payload '{}'",
    "deep:verify": "flue run deep-verify --target node",
    "save:daily": "node scripts/run-daily.mjs",
    "reject": "node scripts/reject.mjs",
    "test:rejections": "node scripts/test-rejections.mjs",
    "test:mediabunny:gist": "node scripts/test-mediabunny-video-convert-local.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@flue/runtime": "1.0.0-beta.1",
    "agents": "^0.14.5",
    "just-bash": "^2.14.2",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@flue/cli": "1.0.0-beta.1",
    "@types/node": "^25.9.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.101.0"
  }
}
