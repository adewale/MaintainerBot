# Required for higher GitHub API limits and draft PR creation.
GITHUB_TOKEN=github_pat_or_classic_token
GITHUB_OWNER=adewale

# Optional LLM review. Without this, MaintainerBot still produces deterministic scan reports.
FLUE_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-key

# Safety gate. Keep false until you are ready for branch pushes/draft PRs.
CREATE_DRAFT_PRS=false

# Optional future email delivery.
EMAIL_TO=you@example.com
EMAIL_FROM=maintainerbot@example.com
RESEND_API_KEY=your-resend-key
