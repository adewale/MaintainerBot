# Optional. Prefer a read-only token; omit it for public unauthenticated GitHub API access.
GITHUB_TOKEN=github_read_only_token_or_leave_blank
GITHUB_OWNER=adewale

# Required. MaintainerBot always calls an LLM to synthesize the daily handoff.
FLUE_MODEL=anthropic/claude-haiku-4-5
ANTHROPIC_API_KEY=your-anthropic-key

# Optional Cloudflare Email Routing delivery. Email is secondary; keep dry-run true unless explicitly needed.
# You must enable Cloudflare Email Routing and verify EMAIL_TO first.
# EMAIL_FROM must be an address on the domain where Email Routing is active.
EMAIL_DRY_RUN=true
EMAIL_TO=you@example.com
EMAIL_FROM=maintainerbot@example.com

# Optional Cloudflare AI Gateway for Anthropic model traffic.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CF_AI_GATEWAY_ID=your-gateway-id
CF_AI_GATEWAY_TOKEN=optional-gateway-token
