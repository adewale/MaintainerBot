{
  "$schema": "https://workers.cloudflare.com/schema/wrangler.json",
  "name": "maintainerbot",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GITHUB_OWNER": "adewale",
    "FLUE_MODEL": "anthropic/claude-haiku-4-5",
    "EMAIL_DRY_RUN": "true"
  },
  "r2_buckets": [
    {
      "binding": "MAINTAINERBOT_R2",
      "bucket_name": "maintainerbot-data"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "workflows": [
    {
      "binding": "MAINTAINERBOT_DAILY",
      "name": "maintainerbot-daily",
      "class_name": "MaintainerDailyWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "flue-class-DailyMaintenance",
      "new_sqlite_classes": ["DailyMaintenance"]
    },
    {
      "tag": "flue-1-runtime-workflows",
      "new_sqlite_classes": ["FlueDeepVerifyWorkflow", "FlueRegistry"],
      "renamed_classes": [
        {
          "from": "DailyMaintenance",
          "to": "FlueDailyMaintenanceWorkflow"
        }
      ]
    },
    {
      "tag": "flue-2-retire-beta-workflows",
      "deleted_classes": ["FlueDailyMaintenanceWorkflow", "FlueDeepVerifyWorkflow", "FlueRegistry"]
    },
    {
      "tag": "flue-2-report-analyst",
      "new_sqlite_classes": ["FlueReportAnalystAgent"]
    }
  ]
}
