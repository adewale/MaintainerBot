{
  "$schema": "https://workers.cloudflare.com/schema/wrangler.json",
  "name": "maintainerbot",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Flue 0.9 backs each workflow with a SQLite-backed Durable Object. The class
  // names are derived from the workflow file names (plus Flue's own registry).
  // `flue build --target cloudflare` injects the durable_objects bindings; this
  // migration registers their SQLite classes for the first deploy.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DailyMaintenanceWorkflow", "DeepVerifyWorkflow", "FlueRegistry"]
    }
  ],
  "vars": {
    "GITHUB_OWNER": "adewale",
    "FLUE_MODEL": "anthropic/claude-haiku-4-5",
    "EMAIL_DRY_RUN": "true"
  },
  "r2_buckets": [
    {
      "binding": "MAINTAINERBOT_R2",
      "bucket_name": "maintainerbot-data"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ]
}
