{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.{ts,mjs}", "tests/**/*.ts", "vite.config.ts", "flue.config.ts"]
}
